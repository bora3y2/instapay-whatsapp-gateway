# Copy to .env and fill in.
PORT=8787
MONGODB_URI=mongodb+srv://...
# openssl rand -base64 48  (same value goes in Vercel as WHATSAPP_GATEWAY_SECRET)
GATEWAY_SECRET=
# Used to expand local numbers such as 01012345678 (Egypt = 20)
DEFAULT_COUNTRY_CODE=20
# Only needed when mongodb+srv:// cannot be resolved (e.g. macOS/local networks)
# DNS_SERVERS=8.8.8.8,1.1.1.1
LOG_LEVEL=info
BAILEYS_LOG_LEVEL=silent
